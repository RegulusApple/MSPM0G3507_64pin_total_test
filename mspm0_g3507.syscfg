GPIO6.associatedPins[0].assignedPort             = "PORTA";
GPIO6.associatedPins[0].assignedPortSegment      = "Upper";
GPIO6.associatedPins[0].assignedPin              = "28";
GPIO6.associatedPins[0].pin.$assign              = "PA28";
